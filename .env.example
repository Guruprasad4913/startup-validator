PORT=5000

# MongoDB connection string. For MongoDB Atlas, replace the placeholders with
# your database user, password, cluster host, and database name.
MONGODB_URI=mongodb://localhost:27017

# Required: powers AI Idea Generation (server/services/aiService.js)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: plug in a real market/trends/competitor API
# (Google Trends via SerpApi, Crunchbase, NewsAPI, etc.)
# See server/services/marketService.js for where this is used.
MARKET_API_KEY=your_market_data_api_key_here
